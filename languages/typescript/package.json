{
  "name": "@avalon-initiative/protocol-sdk",
  "version": "0.1.0",
  "description": "TypeScript reference SDK for Avalon Protocol: AccountSession (first-party account operations, auto-signed) and IntegratorSession (capability-gated integrator access).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avalon-initiative/avalon-sdks.git",
    "directory": "languages/typescript"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run",
    "test:live": "AVALON_SDK_LIVE=1 vitest run --config vitest.live.config.ts",
    "generate": "node scripts/generate-types.mjs && node scripts/generate-trust-anchors.mjs",
    "generate:check": "node scripts/generate-types.mjs && node scripts/generate-trust-anchors.mjs && git diff --exit-code src/generated.ts src/generated/trustedNetworks.json"
  },
  "dependencies": {
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0",
    "@scure/bip39": "^1.5.0",
    "@simplewebauthn/browser": "^14.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "eslint": "^10.0.1",
    "globals": "^15.12.0",
    "openapi-typescript": "^7.13.0",
    "pg": "^8.13.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^2.1.0"
  }
}
